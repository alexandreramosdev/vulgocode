---
import { site, hasContact } from '../config/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-inner">
    <p class="hero-eyebrow">
      <span aria-hidden="true">&lt;/&gt;</span>
      <span class="hero-brand">{site.name}</span>
    </p>

    <h1 id="hero-title" class="hero-title">
      Ideias transformadas em <span class="highlight">soluções digitais</span>.
    </h1>

    <p class="hero-text">
      Desenvolvimento de aplicações web e ferramentas para resolver problemas
      reais — com foco em simplicidade, desempenho e código claro.
    </p>

    <div class="hero-actions">
      <a class="btn btn-primary" href="#projetos">Conhecer os projetos</a>
      {
        hasContact ? (
          <a class="btn btn-ghost" href="#contato">
            Entrar em contato
          </a>
        ) : (
          <a class="btn btn-ghost" href="#servicos">
            Ver serviços
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 3rem + 8vw, 8rem);
  }

  /* Grade sutil de fundo, referência discreta a código */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(139, 92, 246, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(139, 92, 246, 0.05) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, black, transparent 85%);
    -webkit-mask-image: linear-gradient(to bottom, black, transparent 85%);
    pointer-events: none;
  }

  /* Brilho roxo discreto */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 15% 0%,
      rgba(139, 92, 246, 0.14),
      transparent 45%
    );
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 46rem;
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-faint);
  }

  .hero-brand {
    color: var(--color-accent-soft);
    margin-left: 0.4em;
  }

  .hero-title {
    font-size: var(--text-hero);
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .highlight {
    color: var(--color-accent-soft);
  }

  .hero-text {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 38rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  /* Entrada discreta dos elementos */
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-inner > * {
    animation: rise 500ms ease-out both;
  }

  .hero-inner > :nth-child(2) {
    animation-delay: 80ms;
  }

  .hero-inner > :nth-child(3) {
    animation-delay: 160ms;
  }

  .hero-inner > :nth-child(4) {
    animation-delay: 240ms;
  }
</style>
